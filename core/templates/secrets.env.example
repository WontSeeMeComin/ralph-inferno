# Ralph Secrets - Copy to .ralph/secrets.env and fill in your values
# This file is gitignored and should NOT be committed

# Perplexity API key for web search (mcp_search_web tool)
# Get yours at: https://www.perplexity.ai/settings/api
export PERPLEXITY_API_KEY=pplx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenRouter API key (if using OpenRouter as LLM provider)
# Get yours at: https://openrouter.ai/keys
# export OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
